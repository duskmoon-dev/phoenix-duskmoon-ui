<.dm_breadcrumb class="px-4">
  <:crumb to={~p"/components/data-display/popover"}>Data Display</:crumb>
  <:crumb>Popover</:crumb>
</.dm_breadcrumb>

<.dm_card class="w-full h-full overflow-auto" body_class="p-4">
  <:title class="flex flex-row justify-center items-center gap-3">
    <span class="text-4xl text-primary">Popover</span>
    <span class="text-sm opacity-60">dm_popover</span>
  </:title>

  <% md_content = """
  ## Overview
  Native HTML popover using the Popover API and CSS Anchor Positioning.
  The component connects its trigger and surface with an HTML
  `command="toggle-popover"` / `commandfor` pair, so opening, closing,
  light dismiss, and Escape handling do not require custom JavaScript.

  ## Usage
  ```elixir
  <.dm_popover>
    <:trigger :let={trigger_attrs}>
      <.dm_btn variant="primary" {trigger_attrs}>Click me</.dm_btn>
    </:trigger>
    <p>Popover content here.</p>
  </.dm_popover>
  ```
  """ %>
  <.dm_markdown content={md_content} />

  <h3 class="text-xl font-semibold mt-8 mb-4">Basic Popover (Click)</h3>
  <div class="flex gap-4 mb-4">
    <.dm_popover>
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="primary" {trigger_attrs}>Click me</.dm_btn>
      </:trigger>
      <p class="p-3">This popover opens on click.</p>
    </.dm_popover>
  </div>

  <h3 class="text-xl font-semibold mt-8 mb-4">Top Placement</h3>
  <div class="flex gap-4 mb-4">
    <.dm_popover placement="top">
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="secondary" {trigger_attrs}>Open Above</.dm_btn>
      </:trigger>
      <p class="p-3">This popover is anchored above its command invoker.</p>
    </.dm_popover>
  </div>

  <h3 class="text-xl font-semibold mt-8 mb-4">Placement Variants</h3>
  <div class="flex flex-wrap gap-4 mb-4">
    <.dm_popover placement="top">
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="outline" {trigger_attrs}>Top</.dm_btn>
      </:trigger>
      <p class="p-3">Placed on top</p>
    </.dm_popover>

    <.dm_popover placement="bottom">
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="outline" {trigger_attrs}>Bottom</.dm_btn>
      </:trigger>
      <p class="p-3">Placed on bottom</p>
    </.dm_popover>

    <.dm_popover placement="left">
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="outline" {trigger_attrs}>Left</.dm_btn>
      </:trigger>
      <p class="p-3">Placed on left</p>
    </.dm_popover>

    <.dm_popover placement="right">
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="outline" {trigger_attrs}>Right</.dm_btn>
      </:trigger>
      <p class="p-3">Placed on right</p>
    </.dm_popover>
  </div>

  <h3 class="text-xl font-semibold mt-8 mb-4">Custom Offset</h3>
  <div class="flex gap-4 mb-4">
    <.dm_popover offset={0}>
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="info" {trigger_attrs}>Offset 0</.dm_btn>
      </:trigger>
      <p class="p-3">No gap between trigger and popover.</p>
    </.dm_popover>

    <.dm_popover offset={20}>
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="info" {trigger_attrs}>Offset 20</.dm_btn>
      </:trigger>
      <p class="p-3">20px gap between trigger and popover.</p>
    </.dm_popover>
  </div>

  <h3 class="text-xl font-semibold mt-8 mb-4">Without Arrow</h3>
  <div class="flex gap-4 mb-4">
    <.dm_popover arrow={false}>
      <:trigger :let={trigger_attrs}>
        <.dm_btn variant="warning" {trigger_attrs}>No Arrow</.dm_btn>
      </:trigger>
      <p class="p-3">This popover has no arrow indicator.</p>
    </.dm_popover>
  </div>
</.dm_card>
