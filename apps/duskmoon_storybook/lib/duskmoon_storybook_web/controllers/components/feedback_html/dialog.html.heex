<.dm_breadcrumb class="px-4">
  <:crumb to={~p"/components/feedback/dialog"}>Feedback</:crumb>
  <:crumb>Dialog</:crumb>
</.dm_breadcrumb>

<.dm_card class="w-full h-full overflow-auto" body_class="p-4">
  <:title class="flex flex-row justify-center items-center gap-3">
    <span class="text-4xl text-primary">Dialog</span>
    <span class="text-sm opacity-60">dm_modal</span>
  </:title>

  <% md_content = """
  ## Overview
  Modal dialog using the native HTML `<dialog>` element and `@duskmoon-dev/core` dialog CSS.
  Open and close with the Invoker Commands API (`command` / `commandfor`).

  ## Usage
  ```elixir
  <.dm_modal id="my-modal">
    <:trigger :let={id}>
      <.dm_btn variant="primary" command="show-modal" commandfor={id}>Open</.dm_btn>
    </:trigger>
    <:title>Modal Title</:title>
    <:body>Modal content here</:body>
    <:footer>
      <.dm_btn command="close" commandfor="my-modal">Cancel</.dm_btn>
      <.dm_btn variant="primary">Confirm</.dm_btn>
    </:footer>
  </.dm_modal>
  ```
  """ %>
  <.dm_markdown content={md_content} />

  <h3 class="text-xl font-semibold mt-8 mb-4">Basic Modal</h3>
  <.dm_modal id="demo-modal-basic">
    <:trigger :let={id}>
      <.dm_btn variant="primary" command="show-modal" commandfor={id}>
        Open Modal
      </.dm_btn>
    </:trigger>
    <:title>Basic Modal</:title>
    <:body>
      <p>This is a basic modal dialog with a title, body, and footer.</p>
    </:body>
    <:footer>
      <.dm_btn command="close" commandfor="demo-modal-basic" size="sm">Cancel</.dm_btn>
      <.dm_btn variant="primary" size="sm" command="close" commandfor="demo-modal-basic">
        Confirm
      </.dm_btn>
    </:footer>
  </.dm_modal>

  <h3 class="text-xl font-semibold mt-8 mb-4">Sizes</h3>
  <div class="flex flex-wrap gap-4">
    <.dm_modal id="demo-modal-sm" size="sm">
      <:trigger :let={id}>
        <.dm_btn variant="outline" command="show-modal" commandfor={id}>
          Small
        </.dm_btn>
      </:trigger>
      <:title>Small Modal</:title>
      <:body>
        <p>A small modal dialog.</p>
      </:body>
    </.dm_modal>

    <.dm_modal id="demo-modal-lg" size="lg">
      <:trigger :let={id}>
        <.dm_btn variant="outline" command="show-modal" commandfor={id}>
          Large
        </.dm_btn>
      </:trigger>
      <:title>Large Modal</:title>
      <:body>
        <p>A large modal dialog.</p>
      </:body>
    </.dm_modal>

    <.dm_modal id="demo-modal-xl" size="xl">
      <:trigger :let={id}>
        <.dm_btn variant="outline" command="show-modal" commandfor={id}>
          Extra Large
        </.dm_btn>
      </:trigger>
      <:title>Extra Large Modal</:title>
      <:body>
        <p>An extra large modal dialog.</p>
      </:body>
    </.dm_modal>
  </div>

  <h3 class="text-xl font-semibold mt-8 mb-4">Positions</h3>
  <div class="flex flex-wrap gap-4">
    <.dm_modal id="demo-modal-top" position="top">
      <:trigger :let={id}>
        <.dm_btn variant="accent" command="show-modal" commandfor={id}>
          Top
        </.dm_btn>
      </:trigger>
      <:title>Top Modal</:title>
      <:body>
        <p>This modal appears near the top of the viewport.</p>
      </:body>
    </.dm_modal>

    <.dm_modal id="demo-modal-bottom" position="bottom">
      <:trigger :let={id}>
        <.dm_btn variant="accent" command="show-modal" commandfor={id}>
          Bottom
        </.dm_btn>
      </:trigger>
      <:title>Bottom Modal</:title>
      <:body>
        <p>This modal appears near the bottom of the viewport.</p>
      </:body>
    </.dm_modal>
  </div>
</.dm_card>
